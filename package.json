{
  "name": "type-meter",
  "version": "1.0.0",
  "description": "A lightweight Electron app for tracking keyboard activity system-wide with beautiful statistics and analytics",
  "author": "ahmadianrad.saman@gmail.com",
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron .",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:win": "electron-forge make --platform=win32",
    "make:mac": "electron-forge make --platform=darwin",
    "make:linux": "electron-forge make --platform=linux",
    "package:win": "electron-forge package --platform=win32",
    "package:mac": "electron-forge package --platform=darwin",
    "package:linux": "electron-forge package --platform=linux",
    "build:all": "electron-forge make --platform=win32,darwin,linux"
  },
  "keywords": [
    "keyboard-tracker",
    "typing-statistics",
    "productivity",
    "electron",
    "tray-app",
    "keystroke-counter"
  ],
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "electron": "^38.3.0"
  },
  "dependencies": {
    "chart.js": "^4.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "uiohook-napi": "^1.5.4"
  }
}
